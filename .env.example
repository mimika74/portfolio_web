# 公開前の閲覧制限ゲートの合言葉。
# 空ならゲート無効（ローカル開発・一般公開後）。値を入れると /gate で合言葉を要求。
# 共有リンク: https://your-domain.com/?key=あいことば
SITE_ACCESS_KEY=

# 本番ドメイン（sitemap / OGP の絶対URLに使用）
# 例: https://your-domain.com
NUXT_PUBLIC_SITE_URL=

# microCMS（Blog / News 用。概要書 6.）
# サービスドメイン: https://<serviceDomain>.microcms.io の <serviceDomain> 部分
MICROCMS_SERVICE_DOMAIN=
# コンテンツ API の API-KEY
MICROCMS_API_KEY=

# お問い合わせフォーム（Formspree）
# 例: https://formspree.io/f/xxxxxxxx
NUXT_PUBLIC_FORMSPREE_ENDPOINT=

# 「その他のリポジトリ」帯で一覧する GitHub ユーザー名（未設定なら mimika74）
NUXT_PUBLIC_GITHUB_USER=
